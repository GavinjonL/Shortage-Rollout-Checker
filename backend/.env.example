# Copy this file to .env and add credentials there. Never commit .env.
# Supported values: groq, openai, mock
AI_PROVIDER=groq

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Comma-separated browser origins allowed during local frontend development.
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

